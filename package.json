	"scripts": {
		"start": "node proxy/server.js",
		"dev": "vite",
		"dev:server": "nodemon",
		"build": "vite build",
		"preview": "vite preview",
		"test": "concurrently --success first \"npm run dev\" \"wait-on http://127.0.0.1:5173 && cypress run\"",
		"test:build": "cross-env CYPRESS_WS_URL=http://127.0.0.1:9002 VITE_API_URL=http://127.0.0.1:9001 concurrently --success first \"npm run start\" \"wait-on http://127.0.0.1:9001 && cypress run\"",
		"release": "standard-version",
		"lint": "npm run lint:scripts && npm run lint:style",
		"lint:scripts": "eslint src && tsc",
		"lint:style": "stylelint src/**/*.scss",
		"lint:style:fix": "stylelint --fix src/**/*.scss",
		"cypress": "run-p cypress:*",
		"cypress:start-cra": "NODE_ENV=production PORT=5173 npm run dev",
		"cypress:wait-and-open": "run-s cypress:wait-and-open:open cypress:wait-and-open:wait-on-cra",
		"cypress:wait-and-open:wait-on-cra": "wait-on http://127.0.0.1:5173",
		"cypress:wait-and-open:open": "cross-env NODE_ENV=production cypress open",
		"dtsgen": "ts-node dtsgen.ts",
		"browserstack": "browserstack-cypress run --sync"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"prettier": {
		"trailingComma": "none",
		"singleQuote": true,
		"useTabs": true,
		"tabWidth": 4,
		"quoteProps": "consistent"
	},
	"lint-staged": {
		"**/*.+(js|jsx|css|less|scss|ts|tsx|md|json)": [
			"npx prettier --write"
		]
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"nodemonConfig": {
		"exec": "npm run dev",
		"watch": [
			"proxy/"
		],
		"delay": 2500
	},
	"browserslist": [
		"baseline widely available"
	]
}
